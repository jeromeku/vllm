{
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
        "vllm": {
            "class": "vllm.logging_utils.NewLineFormatter",
            "datefmt": "%m-%d %H:%M:%S",
            "format": "%(levelname)s %(asctime)s [%(pathname)s:%(lineno)d] %(message)s"
        }
    },
    "handlers": {
        "file": {
            "class": "logging.FileHandler",
            "formatter": "vllm",
            "level": "DEBUG",
            "filename": "vllm.debug.log",
            "mode": "w"
        }
    },
    "loggers": {
        "vllm": {
            "handlers": ["file"],
            "level": "DEBUG",
            "propagate": false
        }
    }
}